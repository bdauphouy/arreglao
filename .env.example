# Copy this file to .env and fill in real values.
# Only EXPO_PUBLIC_* vars are available in client code — never put secrets here.

# Backend API base URL
EXPO_PUBLIC_API_URL=https://api.example.com

# Sentry (https://sentry.io) — client DSN, safe to expose publicly
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (https://posthog.com) — project API key, safe to expose publicly
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Used only by app.config.ts at build time (not exposed to the client bundle)
EAS_PROJECT_ID=
SENTRY_ORG=
SENTRY_PROJECT=
